<?xml version='1.0' encoding='utf-8'?>
<mixer>
	<!-- gbos: HDA controls start muted at volume 0; unmute them. Controls the codec
	     doesn't have are skipped by audio_route. -->
	<ctl name="Master Playback Switch" value="1" />
	<ctl name="Master Playback Volume" value="87" />
	<ctl name="Speaker Playback Switch" value="1 1" />
	<ctl name="Headphone Playback Switch" value="1 1" />
	<ctl name="Capture Switch" value="1 1" />
	<ctl name="Capture Volume" value="39 39" />
	<ctl name="IEC958 Playback Switch" value="1" />
	<path name="Speaker">
		<ctl name="Speaker Playback Switch" value="1 1" />
	</path>
	<path name="Headphone">
		<ctl name="Headphone Playback Switch" value="1 1" />
	</path>
	<path name="Mic">
		<ctl name="Capture Switch" value="1 1" />
	</path>
</mixer>
